{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "lib": ["esnext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true
  },
  "include": ["src/server", "src/common"],
  "exclude": ["src/server/**/*.test.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
